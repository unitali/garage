rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tudo o que não está listado abaixo é negado (inclusive outras coleções dentro de users/{uid}).

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function text(v, max) {
      return v is string && v.size() <= max;
    }
    function optText(d, k, max) {
      return !(k in d) || text(d[k], max);
    }
    function optNum(d, k) {
      return !(k in d) || d[k] == null || d[k] is number;
    }
    function optInt(d, k) {
      return !(k in d) || d[k] == null || d[k] is int;
    }
    function optList(d, k, max) {
      return !(k in d) || (d[k] is list && d[k].size() <= max);
    }
    function optNullText(d, k, max) {
      return !(k in d) || d[k] == null || text(d[k], max);
    }
    // AAAA-MM-DD com mês 01–12 e dia 01–31 (a ordenação do app é por esse texto)
    function isDate(v) {
      return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    // createdAt não muda depois de criado (documentos antigos sem ele podem ganhar um)
    function keepsCreatedAt() {
      return !('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt;
    }

    // users/{uid}: preferências da conta (alertMonths, urgentKm e urgentDays: campos antigos, ainda aceitos)
    function validPrefs(d) {
      return d.keys().hasOnly(['serviceCategories', 'expenseCategories', 'alertKm', 'alertDays', 'alertMonths', 'urgentKm', 'urgentDays'])
        && optList(d, 'serviceCategories', 200) && optList(d, 'expenseCategories', 200)
        && optInt(d, 'alertKm') && optInt(d, 'alertDays') && optInt(d, 'alertMonths') && optInt(d, 'urgentKm') && optInt(d, 'urgentDays');
    }

    function validVehicle(d) {
      return d.keys().hasOnly(['name', 'type', 'plate', 'initialOdometer', 'odometer', 'createdAt'])
        && d.keys().hasAll(['name', 'type', 'initialOdometer', 'createdAt'])
        && text(d.name, 60) && d.name.size() > 0
        && d.type in ['carro', 'moto', 'bike', 'caminhao', 'outro']
        && optText(d, 'plate', 10)
        && d.initialOdometer is number && d.initialOdometer >= 0
        && optNum(d, 'odometer')
        && d.createdAt is int;
    }

    function validEntry(d) {
      return d.keys().hasOnly(['kind', 'date', 'odometer', 'amount', 'category', 'description', 'notes', 'createdAt',
                               'fuelType', 'liters', 'pricePerLiter', 'fullTank', 'title', 'items', 'series', 'paid'])
        && d.keys().hasAll(['kind', 'date', 'amount', 'category', 'createdAt'])
        && d.kind in ['fuel', 'service', 'expense']
        && isDate(d.date)
        && d.amount is number && d.amount >= 0 && d.amount < 100000000
        && optNum(d, 'odometer')
        && text(d.category, 60)
        && optText(d, 'description', 2000) && optText(d, 'notes', 2000) && optText(d, 'title', 60) && optText(d, 'fuelType', 40)
        && optNum(d, 'liters') && optNum(d, 'pricePerLiter')
        && (!('fullTank' in d) || d.fullTank is bool)
        && (!('paid' in d) || d.paid is bool)
        && optList(d, 'items', 50)
        && (!('series' in d) || (d.series is map && d.series.keys().hasOnly(['id', 'type', 'index', 'count'])))
        && d.createdAt is int;
    }

    function validReminder(d) {
      return d.keys().hasOnly(['title', 'intervalKm', 'intervalMonths', 'lastKm', 'lastDate', 'createdAt'])
        && d.keys().hasAll(['title', 'createdAt'])
        && text(d.title, 60) && d.title.size() > 0
        && optNum(d, 'intervalKm') && optInt(d, 'intervalMonths') && optNum(d, 'lastKm')
        && (!('lastDate' in d) || d.lastDate == null || isDate(d.lastDate))
        && d.createdAt is int;
    }

    // Cada usuário só lê e escreve os próprios dados; cada lançamento/lembrete fica dentro do seu veículo.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && validPrefs(request.resource.data);

      match /vehicles/{vid} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid) && validVehicle(request.resource.data);
        allow update: if isOwner(uid) && validVehicle(request.resource.data) && keepsCreatedAt();

        match /entries/{eid} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validEntry(request.resource.data);
          allow update: if isOwner(uid) && validEntry(request.resource.data) && keepsCreatedAt();
        }
        match /reminders/{rid} {
          allow read, delete: if isOwner(uid);
          allow create: if isOwner(uid) && validReminder(request.resource.data);
          allow update: if isOwner(uid) && validReminder(request.resource.data) && keepsCreatedAt();
        }
      }
    }

    // ---------- cópia ao excluir a conta ----------
    // O app só cria (não lê, não altera, não apaga); restaurar é coisa de administrador
    // (scripts/restore-account.mjs). Limites contra abuso:
    //  - id "AAAAMMDD-N": data de hoje (UTC), N de 1 a 3 → no máximo 3 cópias por dia
    //  - a capa (meta) vem primeiro e diz quantos documentos a cópia tem (até 5.000); cada documento tem
    //    id numérico menor que isso → não dá para escrever além do declarado
    //  - cada documento passa pela mesma validação do original (tamanhos e campos) e o caminho tem o
    //    formato de um caminho do app (é com ele que a restauração monta o nome do documento)
    //  - tudo expira: expireAt (até 91 dias) é o campo da política de TTL do Firestore
    function backupId(bid) {
      return bid.matches('^[0-9]{8}-[1-3]$')
        && int(bid.split('-')[0]) == request.time.year() * 10000 + request.time.month() * 100 + request.time.day();
    }
    function expiresSoon(t) {
      return t is timestamp && t > request.time && t <= request.time + duration.value(91, 'd');
    }
    function validBackupDoc(path, d) {
      return path is string && d is map && (
        (path == '.' && validPrefs(d))
        || (path.matches('^vehicles/[A-Za-z0-9_-]{1,40}$') && validVehicle(d))
        || (path.matches('^vehicles/[A-Za-z0-9_-]{1,40}/entries/[A-Za-z0-9_-]{1,40}$') && validEntry(d))
        || (path.matches('^vehicles/[A-Za-z0-9_-]{1,40}/reminders/[A-Za-z0-9_-]{1,40}$') && validReminder(d))
      );
    }

    match /trash/{uid}/backups/{bid} {
      allow create: if isOwner(uid) && backupId(bid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'deletedAt', 'docs', 'expireAt'])
        && request.resource.data.keys().hasAll(['uid', 'deletedAt', 'docs', 'expireAt'])
        && request.resource.data.uid == uid
        && optNullText(request.resource.data, 'email', 200) && optNullText(request.resource.data, 'name', 200)
        && request.resource.data.deletedAt is int
        && request.resource.data.docs is int && request.resource.data.docs >= 1 && request.resource.data.docs <= 5000
        && expiresSoon(request.resource.data.expireAt);

      match /docs/{n} {
        allow create: if isOwner(uid)
          && n.matches('^[0-9]{1,4}$')
          && request.resource.data.keys().hasOnly(['path', 'data', 'expireAt'])
          && request.resource.data.keys().hasAll(['path', 'data', 'expireAt'])
          && int(n) < get(/databases/$(database)/documents/trash/$(uid)/backups/$(bid)).data.docs
          && request.resource.data.expireAt == get(/databases/$(database)/documents/trash/$(uid)/backups/$(bid)).data.expireAt
          && validBackupDoc(request.resource.data.path, request.resource.data.data);
      }
    }
  }
}
