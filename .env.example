# Copie para .env.local e preencha com os dados do app web no Firebase Console
# (Configurações do projeto > Seus apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
# Em dev: seu-projeto.firebaseapp.com
# Em produção na Vercel (com o proxy do vercel.json): seu-dominio.vercel.app
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=